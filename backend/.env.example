PORT=5000
NODE_ENV=development

# Neon (recommandé) : une seule URL — laisse DB_HOST vide
DATABASE_URL=
# Désactiver SSL explicite si besoin (rare)
# DB_SSL=false

# Ou PostgreSQL classique (local)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cafe_db
DB_USER=postgres
DB_PASSWORD=

# JWT / auth (génère une chaîne longue en prod)
JWT_SECRET=change-me-in-production

# --- CORS (frontend autorisé à appeler l’API) ---
# Liste d’URLs séparées par des VIRGULES, sans espace autour des virgules.
# Remplace par ton URL Vercel réelle après déploiement.
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173

# Optionnel : 2e liste fusionnée avec la première (pratique si tu sépares prod / previews)
# Même format virgules. Tu peux laisser vide.
CORS_ORIGINS=

# Exemple production (commente ALLOWED_ORIGINS ci-dessus et décommente) :
# ALLOWED_ORIGINS=https://el-nadhour-frontend.vercel.app
# CORS_ORIGINS=https://el-nadhour-frontend-git-main-saber5180.vercel.app

# Déconseillé : tout le monde (surtout si credentials: true côté client)
# ALLOWED_ORIGINS=*

# --- Stockage images persistant (Render-safe) ---
# Sans ces variables : fallback local /uploads (éphémère sur Render).
# Avec ces variables : upload Cloudinary (persistant).
# Option A (recommandé) : une seule variable Cloudinary URL
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
#
# Option B : variables séparées
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
