# ==============================================
# El Nadhour - Production Environment Variables
# ==============================================
# Copy this file to .env on your VPS server
# and change the values below!
# ==============================================

# Database password (CHANGE THIS!)
DB_PASSWORD=put_a_strong_password_here

# JWT Secret for authentication (CHANGE THIS!)
JWT_SECRET=put_a_long_random_string_here

# Your domain (for CORS)
ALLOWED_ORIGINS=https://elnadhoure-cafe.tn,https://www.elnadhoure-cafe.tn
