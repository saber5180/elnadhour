root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

# Shell scripts run on the Linux VPS. CRLF endings make bash fail with
# "$'\r': command not found", so these must stay LF even on Windows.
[*.sh]
end_of_line = lf

[*.{yml,yaml}]
end_of_line = lf
indent_style = space
indent_size = 2

[Dockerfile*]
end_of_line = lf

[nginx.conf]
end_of_line = lf

[*.ps1]
end_of_line = crlf
